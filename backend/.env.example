# Settings for running the backend WITHOUT Docker (development).
# The Docker setup in deploy/ sets these itself from deploy/.env.
DATABASE_URL=postgresql+psycopg://ohd:ohd@localhost:5432/ohd
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET=
SESSION_HOURS=72
COOKIE_SECURE=false          # true behind HTTPS
STORAGE_BACKEND=local        # bill photos on disk
UPLOAD_DIR=./uploads
CORS_ORIGINS=http://localhost:5173
DEFAULT_OUTLET_ID=1
